# Maintainer: Bikram Kumar Das <bikramkumardas@proton.me>
pkgname=bluetooth-autoconnect
pkgver=1.0.0
pkgrel=1
pkgdesc="Automatically reconnect paired, trusted Bluetooth devices via BlueZ D-Bus"
arch=('any')
url="https://github.com/Zero-day-Exploit-np/bluetooth-autoconnect"
license=('MIT')
depends=('python' 'python-dbus-next' 'bluez' 'bluez-utils' 'systemd')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
optdepends=('python-systemd: native systemd journal logging with structured fields')
backup=('etc/bluetooth-autoconnect/config.yaml')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Zero-day-Exploit-np/bluetooth-autoconnect/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # replace with: updpkgsums

build() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 systemd/bluetooth-autoconnect.service \
    "$pkgdir/usr/lib/systemd/system/bluetooth-autoconnect.service"
  install -Dm644 systemd/bluetooth-autoconnect-user.service \
    "$pkgdir/usr/lib/systemd/user/bluetooth-autoconnect.service"

  install -Dm644 etc/bluetooth-autoconnect/config.yaml \
    "$pkgdir/etc/bluetooth-autoconnect/config.yaml"

  install -Dm644 README.md \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/TROUBLESHOOTING.md \
    "$pkgdir/usr/share/doc/$pkgname/TROUBLESHOOTING.md"
  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
