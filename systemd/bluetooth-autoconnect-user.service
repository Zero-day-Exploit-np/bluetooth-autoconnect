[Unit]
Description=Bluetooth Auto-Connect (per-user daemon)
Documentation=https://github.com/Zero-day-Exploit-np/bluetooth-autoconnect
# bluetooth.target is a system target; it is NOT visible in the user
# manager instance.  Order after default.target so the session is up
# before we try to reach the D-Bus system bus.
After=default.target
# Restart-rate limiting belongs in [Unit], not [Service] (systemd >= 230).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# %h expands to the user's home directory (requires systemd >= 236).
ExecStart=%h/.local/bin/bluetooth-autoconnect --daemon
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
SendSIGHUP=no

# Hardening (subset supported by user manager instances)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
PrivateTmp=true

[Install]
WantedBy=default.target
