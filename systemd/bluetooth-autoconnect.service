[Unit]
Description=Bluetooth Auto-Connect (system-wide daemon)
Documentation=https://github.com/Zero-day-Exploit-np/bluetooth-autoconnect
After=bluetooth.target bluetooth.service dbus.socket
Wants=bluetooth.target
# Restart-rate limiting belongs in [Unit], not [Service] (systemd >= 230).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/bluetooth-autoconnect --daemon
Restart=on-failure
RestartSec=5

# SIGHUP triggers a rescan rather than config reload — prevent systemd
# from sending it on stop/reload so the app handles it exclusively.
KillSignal=SIGTERM
SendSIGHUP=no

# Sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
LockPersonality=true
RestrictNamespaces=true
PrivateNetwork=true

[Install]
WantedBy=multi-user.target
